{
  "language": "rust",
  "comment_kinds": ["line_comment", "block_comment"],
  "string_kinds": ["string_literal", "raw_string_literal"],
  "unwrap_kinds": [],
  "test_attribute_markers": ["cfg(test)", "#[test]"],
  "test_attribute_kinds": ["attribute_item", "inner_attribute_item"],
  "kinds": {
    "branch_condition": {
      "field_of": [["if_expression", "condition"], ["while_expression", "condition"]],
      "returned": {"of": ["return_expression"], "kinds": ["binary_expression", "unary_expression"],
                   "tokens": ["&&", "||", "!", "==", "!=", "<", ">", "<=", ">="]}
    },
    "failure_state": {
      "nodes": ["return_expression", "try_expression"],
      "nodes_with_prefix": {"call_expression": ["Err("], "macro_invocation": ["panic!", "bail!", "unreachable!"]}
    },
    "error_order": {"nodes": ["if_expression"], "requires_next_sibling": true},
    "state_write": {"nodes": ["assignment_expression", "compound_assignment_expr"],
                    "call_statements": ["call_expression", "await_expression"]},
    "pure_shell_boundary": {"nodes": ["function_item"]}
  },
  "noop_statement": ";",
  "statement_wrappers": ["expression_statement"],
  "statement_terminator": ";",
  "operators": {
    "branch_condition": {"template": "!({text})", "exclude_kinds": ["let_condition", "let_chain"],
                         "token_swaps": [["==", "!="], ["<", "<="], [">", ">="], ["&&", "||"]],
                          "negation_swaps": [["==", "!="]]},
    "failure_state": {"by_kind": {"try_expression": "{child0}.unwrap()"},
                      "returned_literal_swaps": [["true", "false"], ["0", "1"]]},
    "state_write": {"statement": "{noop}"},
    "error_order": {"swap_next": true}
  },
  "gaps": [{"reason": "unsafe code", "nodes": ["unsafe_block"]}, {"reason": "raw pointer", "nodes": ["pointer_type"]},
           {"reason": "dynamic dispatch", "nodes": ["dynamic_type"]},
           {"reason": "unmonitored thread", "nodes_with_prefix": {"call_expression": ["thread::spawn(", "std::thread::spawn("]}},
           {"reason": "interior mutability", "nodes_with_prefix": {"generic_type": ["RefCell<", "Mutex<", "RwLock<"]}}]
}
