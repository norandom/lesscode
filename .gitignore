# Disposable Python and analyzer environments
.venv/
.venv-*/
.tools/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local evaluation artifacts and disposable copies
runs/
.runs/*
!.runs/e4-lifecycle/
!.runs/e3-facdrone/
.runs/e4-lifecycle/*
!.runs/e4-lifecycle/*.json
!.runs/e4-lifecycle/*.sha256
!.runs/e4-lifecycle/*.sqlite
.runs/e3-facdrone/*
!.runs/e3-facdrone/*.sqlite
.workspaces/

# Local model endpoint configuration with secrets; .env.sample is the tracked template.
.env
.env.*
!.env.sample
