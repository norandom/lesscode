# Synthetic fixture identities use LF bytes on every supported platform.
tests/fixtures/python/** text eol=lf
# Notice filenames identify exact upstream distribution bytes, including CRLF.
tools/notices/*.txt -text
tools/*.sh text eol=lf
# Exact byte identity for admission turn fixtures and lifecycle runs
docs/experiments/deconvolution/regenerator/results/turns/** text eol=lf
.runs/e4-lifecycle/** text eol=lf
.runs/e3-facdrone/** text eol=lf
# Release installer runs under POSIX sh on Linux and macOS.
scripts/*.sh text eol=lf
scripts/release-public-keys.txt text eol=lf
# Prototype inputs are frozen by hash in the research log; keep their bytes stable.
docs/experiments/annotation-driver/** text eol=lf
# Shipped language packs are embedded and identified by hash; keep their bytes stable.
native/packs/*.json text eol=lf
# Parity fixtures of the agnostic driver: mutant hashes depend on the exact bytes (CRLF as at the gate).
native/tests/fixtures/driver/scopes/** -text
native/tests/fixtures/driver/reference/*.json text eol=lf
native/tests/fixtures/driver/model-packs/*.json text eol=lf
native/tests/fixtures/driver/gate-packs/*.json text eol=lf
native/tests/fixtures/driver/controls/** text eol=lf
