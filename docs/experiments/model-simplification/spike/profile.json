      {"kind": "elif_clause", "field": "condition"},
      {"kind": "while_statement", "field": "condition"},
      {"kind": "conditional_expression", "named_child": 1},
      {"kind": "if_clause", "named_child": 0},
      {"kind": "assert_statement", "named_child": 0}
    ],
    "boolean": ["boolean_operator"],
    "comparisons": ["comparison_operator"],
    "wrappers": ["parenthesized_expression", "not_operator"],
    "unary_roots": ["not_operator"]
  }
