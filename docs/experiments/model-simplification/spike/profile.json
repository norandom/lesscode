{
  "version": "syntax-census-draft-3",
  "language": "python",
  "owners": ["class_definition", "function_definition", "lambda"],
  "branches": ["if_statement", "elif_clause", "conditional_expression", "while_statement", "for_statement", "for_in_clause", "if_clause", "assert_statement"],
  "decisions": ["boolean_operator", "comparison_operator"],
  "handlers": ["except_clause"],
  "effects": ["assignment", "augmented_assignment", "call", "delete_statement", "global_statement", "nonlocal_statement", "yield", "await"],
  "unsupported": ["match_statement", "exec_statement"],
  "bindings": {
    "assignments": ["assignment"],
    "identifier": "identifier",
