+def test_checkpoint_clear_says_so(tmp_path: Path, capsys) -> None:
+    """``clear()`` prints one line that tells the user the checkpoint is gone."""
+    cp = Checkpoint(str(tmp_path))
+    cp.save(user_id="user_a", tweets=[_make_tweet("1", "hi")], cursor="abc", total_fetched=1)
+    capsys.readouterr()
+
+    cp.clear()
+
+    assert capsys.readouterr().out == "✓ Checkpoint cleared\n"
+
+
+def test_checkpoint_clear_without_files(tmp_path: Path, capsys) -> None:
+    """``clear()`` on a directory with no checkpoint does not fail."""
+    cp = Checkpoint(str(tmp_path))
+
+    cp.clear()
+
+    assert capsys.readouterr().out == "✓ Checkpoint cleared\n"
+    assert cp.exists() is False
+
+
