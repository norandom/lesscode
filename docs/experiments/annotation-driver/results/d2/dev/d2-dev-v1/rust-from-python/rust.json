{
  "language": "rust",
  "comment_kinds": ["line_comment", "block_comment"],
  "string_kinds": ["string_literal", "raw_string_literal"],
  "unwrap_kinds": [],
  "test_attribute_markers": ["#[test]", "#[cfg(test)]"],
  "kinds": {
    "branch_condition": {"field_of": [["if_expression", "condition"], ["while_expression", "condition"], ["match_pattern", "condition"]]},
    "failure_state": {
      "nodes": ["return_expression", "try_expression"],
      "nodes_with_prefix": {"macro_invocation": ["panic!", "unreachable!", "todo!", "unimplemented!"], "call_expression": ["Err("]}
    },
    "error_order": {"nodes": ["if_expression"], "requires_next_sibling": true},
    "state_write": {"nodes": ["assignment_expression", "compound_assignment_expr"]},
    "pure_shell_boundary": {"nodes": ["function_item"]}
  },
  "noop_statement": "{}",
  "statement_wrappers": ["expression_statement"],
  "operators": {
    "branch_condition": {"template": "!({text})", "exclude_kinds": ["let_condition", "let_chain"]},
    "failure_state": {"by_kind": {"macro_invocation": "{noop}"}},
    "state_write": {"statement": "{noop}"},
    "error_order": {"swap_next": true}
  }
}
