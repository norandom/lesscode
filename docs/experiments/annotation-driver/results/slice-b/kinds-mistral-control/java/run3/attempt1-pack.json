{
  "language": "java",
  "comment_kinds": ["line_comment", "block_comment"],
  "string_kinds": ["string_literal", "text_block"],
  "unwrap_kinds": ["parenthesized_expression"],
  "test_attribute_markers": [],
  "kinds": {
    "branch_condition": {
      "field_of": [["if_statement", "condition"], ["while_statement", "condition"], ["do_statement", "condition"], ["for_statement", "condition"], ["ternary_expression", "condition"]],
      "returned": {"of": ["return_statement"], "kinds": ["binary_expression", "unary_expression"],
                   "tokens": ["&&", "||", "!", "==", "!=", "<", ">", "<=", ">="]}
    },
    "failure_state": {"nodes": ["throw_statement", "return_statement"]},
    "error_order": {"nodes": ["if_statement"], "requires_next_sibling": true},
    "state_write": {"nodes": ["assignment_expression", "update_expression"],
                    "call_statements": ["method_invocation"]},
    "pure_shell_boundary": {"nodes": ["method_declaration", "constructor_declaration"]}
  },
  "noop_statement": ";",
  "statement_wrappers": ["expression_statement"],
  "statement_terminator": ";",
  "operators": {
    "branch_condition": {"template": "!({text})",
                         "token_swaps": [["==", "!="], ["<", "<="], [">", ">="], ["&&", "||"]],
                         "negation_swaps": [["==", "!="]]},
    "failure_state": {"by_kind": {"throw_statement": "{noop}"},
                      "returned_literal_swaps": [["true", "false"], ["0", "1"]]},
    "state_write": {"statement": "{noop}"},
    "error_order": {"swap_next": true}
  },
  "gaps": [
    {"reason": "reflection", "nodes_with_prefix": {"method_invocation": ["Class.forName(", "Proxy.newProxyInstance("]}},
    {"reason": "thread creation", "nodes_with_prefix": {"object_creation_expression": ["new Thread("], "method_invocation": ["Executors."]}}
  ]
}
