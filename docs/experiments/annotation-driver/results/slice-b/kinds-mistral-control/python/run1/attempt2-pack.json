{
  "language": "python",
  "comment_kinds": ["comment"],
  "string_kinds": ["string", "concatenated_string"],
  "unwrap_kinds": ["parenthesized_expression"],
  "test_attribute_markers": [],
  "kinds": {
    "branch_condition": {
      "field_of": [["if_statement", "condition"], ["elif_clause", "condition"], ["while_statement", "condition"], ["conditional_expression", "condition"]],
      "returned": {"of": ["return_statement"], "kinds": ["boolean_operator", "comparison_operator", "unary_operator"],
                   "tokens": ["and", "or", "not", "==", "!=", "<", ">", "<=", ">=", "in", "not in", "is", "is not"]}
    },
    "failure_state": {"nodes": ["raise_statement", "return_statement", "assert_statement"],
                      "nodes_with_prefix": {"call": ["exit(", "quit(", "sys.exit(", "os._exit("]}},
    "error_order": {"nodes": ["if_statement"], "requires_next_sibling": true},
    "state_write": {"nodes": ["assignment", "augmented_assignment", "named_expression"], "call_statements": ["call", "await"]},
    "pure_shell_boundary": {"nodes": ["function_definition"]}
  },
  "noop_statement": "pass",
  "statement_wrappers": ["expression_statement"],
  "operators": {
    "branch_condition": {"template": "not ({text})",
                         "token_swaps": [["==", "!="], ["<", "<="], [">", ">="], ["and", "or"], ["is", "is not"], ["in", "not in"]],
                         "negation_swaps": [["==", "!="], ["is", "is not"], ["in", "not in"]]},
    "failure_state": {"by_kind": {"raise_statement": "{noop}", "assert_statement": "{noop}"},
                      "returned_literal_swaps": [["True", "False"], ["0", "1"]]},
    "state_write": {"statement": "{noop}"},
    "error_order": {"swap_next": true}
  },
  "gaps": [
    {"reason": "import side effects", "nodes": ["import_statement", "import_from_statement"]},
    {"reason": "dynamic execution", "nodes_with_prefix": {"call": ["exec(", "eval(", "__import__("]}},
    {"reason": "unmonitored thread", "nodes_with_prefix": {"call": ["threading.Thread(", "multiprocessing.Process("]}},
    {"reason": "context manager or global state", "nodes": ["with_statement", "global_statement", "nonlocal_statement", "delete_statement"]}
  ]
}
