{
  "language": "python",
  "comment_kinds": ["comment"],
  "string_kinds": ["string"],
  "unwrap_kinds": [],
  "test_attribute_markers": [],
  "kinds": {
    "branch_condition": {
      "field_of": [["if_statement", "condition"], ["elif_clause", "condition"], ["while_statement", "condition"], ["conditional_expression", "condition"]],
      "returned": {"of": ["return_statement"], "kinds": ["boolean_operator", "comparison_operator", "unary_operator"],
                   "tokens": ["and", "or", "not", "==", "!=", "<", ">", "<=", ">=", "is", "is not", "in", "not in"]}
    },
    "failure_state": {
      "nodes": ["raise_statement", "return_statement"],
      "nodes_with_prefix": {"call": ["sys.exit(", "exit(", "quit(", "os._exit(", "abort("]}
    },
    "error_order": {"nodes": ["if_statement"], "requires_next_sibling": true},
    "state_write": {"nodes": ["assignment", "augmented_assignment"],
                    "call_statements": ["call", "await"]},
    "pure_shell_boundary": {"nodes": ["function_definition"]}
  },
  "noop_statement": "pass",
  "statement_wrappers": ["expression_statement"],
  "operators": {
    "branch_condition": {"template": "not ({text})",
                         "token_swaps": [["==", "!="], ["<", "<="], [">", ">="], ["and", "or"], ["is", "is not"], ["in", "not in"]],
                         "negation_swaps": [["==", "!="], ["is", "is not"], ["in", "not in"]]},
    "failure_state": {"by_kind": {"raise_statement": "{noop}"},
                      "returned_literal_swaps": [["True", "False"], ["0", "1"]]},
    "state_write": {"statement": "{noop}"},
    "error_order": {"swap_next": true}
  },
  "gaps": [{"reason": "dynamic code execution", "nodes_with_prefix": {"call": ["eval(", "exec("]}},
           {"reason": "dynamic attribute access", "nodes_with_prefix": {"call": ["getattr(", "setattr(", "delattr("]}},
           {"reason": "dynamic import", "nodes_with_prefix": {"call": ["__import__(", "importlib.import_module("]}},
           {"reason": "unmonitored thread", "nodes_with_prefix": {"call": ["threading.Thread(", "Thread("]}}]
}
