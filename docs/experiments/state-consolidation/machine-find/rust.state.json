{
  "language": "rust",
  "comments": ["line_comment", "block_comment"],
  "units": {"function_item": "name", "closure_expression": ""},
  "binding": {"node": "let_declaration", "name": "pattern", "value": "value"},
  "bound": {"leaf": "identifier", "not_field": "type"},
  "field": {"node": "field_declaration", "name": "name", "type": "type", "receiver": "self."},
  "tuple": {"node": "ordered_field_declaration_list", "skip": ["visibility_modifier", "attribute_item"]},
  "struct": {"node": "struct_item", "name": "name"},
  "impl": {"node": "impl_item", "type": "type"},
  "literal": {"of": "struct_expression", "name": "name", "self": "Self",
              "shorthand": "shorthand_field_initializer",
              "node": "field_initializer", "field": "field", "value": "value"},
  "cells": ["Cell", "RefCell", "OnceCell", "OnceLock", "Mutex", "RwLock",
            "AtomicBool", "AtomicUsize", "AtomicU32", "AtomicU64", "AtomicI64"],
  "constructor": "::new",
  "aliases": ["{}", "&{}", "&mut {}", "{}.clone()", "Arc::clone(&{})", "Rc::clone(&{})"],
  "method": {"node": "call_expression", "callee": "function", "access": "field_expression",
             "receiver": "value", "name": "field"},
  "writes": ["set", "replace", "take", "swap", "store", "borrow_mut", "get_mut", "lock", "write",
             "fetch_add", "fetch_sub", "get_or_init"],
  "reads": ["get", "take", "borrow", "load", "lock", "read", "into_inner", "get_or_init"],
  "handles": ["lock", "try_lock", "read", "write", "try_read", "try_write"],
  "conditions": [["if_expression", "condition"], ["while_expression", "condition"],
                 ["match_expression", "value"], ["let_declaration", "value", "alternative"]],
  "let_condition": {"node": "let_condition", "value": "value"},
  "arms": {"of": "match_expression", "node": "match_arm", "pattern": "pattern", "open": ["_"]},
  "call": {"node": "call_expression", "callee": "function", "arguments": "arguments"},
  "parameters": {"field": "parameters", "name": "pattern"}
}
