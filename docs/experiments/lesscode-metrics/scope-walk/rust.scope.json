{
  "language": "rust",
  "struct": {"node": "struct_item", "name": "name", "generics": "type_parameters"},
  "field": {"node": "field_declaration", "name": "name", "type": "type"},
  "enum": {"node": "enum_item", "name": "name", "variant": "enum_variant", "variant_name": "name", "variant_body": "body"},
  "impl": {"node": "impl_item", "type": "type", "trait": "trait", "own_type": "Self"},
  "function": {"node": "function_item", "name": "name", "returns": "return_type", "parameters": "parameters",
               "generics": "type_parameters", "modifiers": "function_modifiers", "left_out": ["async", "unsafe", "extern"]},
  "receiver": {"node": "self_parameter", "shared": "&", "changing": "mut"},
  "parameter": {"node": "parameter", "type": "type"},
  "module": {"node": "mod_item", "body": "body"},
  "attribute": "attribute_item",
  "comments": ["line_comment", "block_comment"],
  "test_marker": "cfg(test)",
  "conditional_marker": "cfg(",
  "derives": {"default": ["derive(", "Default"], "clone": ["derive(", "Clone"]},
  "default_trait": "Default",
  "length": 4,
  "budget": 3000000,
  "seconds": 120,
  "rounds": 4,
  "observe": {
    "bool": "{x}",
    "AtomicBool": "{x}.load(std::sync::atomic::Ordering::SeqCst)",
    "Option": "{x}.is_some()",
    "OnceLock": "{x}.get().is_some()",
    "OnceCell": "{x}.get().is_some()"
  },
  "enter": {
    "Mutex": "(*{x}.lock().unwrap())",
    "RwLock": "(*{x}.read().unwrap())",
    "RefCell": "(*{x}.borrow())",
    "Arc": "(*{x})",
    "Rc": "(*{x})",
    "Box": "(*{x})"
  },
  "variant": "{E}::{V} { .. } => {n}u8,",
  "pick": "match &{x} { {arms} #[allow(unreachable_patterns)] _ => 255u8 }",
  "shared": "Arc",
  "shared_path": "std::sync::Arc",
  "unwrap": {"Option": "if let Some(r) = r { {then} }", "Result": "if let Ok(r) = r { {then} }"},
  "parent": "super::",
  "values": {
    "u8": ["0", "1", "4"], "u16": ["0", "1", "4"], "u32": ["0", "1", "4"], "u64": ["0", "1", "4"],
    "usize": ["0", "1", "4"], "i32": ["0", "1", "4"], "i64": ["0", "1", "4"],
    "f32": ["0.0", "1.0"], "f64": ["0.0", "1.0"],
    "bool": ["false", "true"],
    "(u32, u32)": ["(0, 0)", "(1, 1)", "(4, 4)"],
    "&[u8]": ["&[]", "&[7u8; 64]"],
    "&str": ["\"\"", "\"a\""],
    "String": ["String::new()", "String::from(\"a\")"]
  },
  "values_by_head": {"Option": ["None"], "Vec": ["Vec::new()"], "Duration": ["std::time::Duration::from_millis(1)"]}
}
