{
  "language": "rust",
  "struct": {"node": "struct_item", "name": "name", "generics": "type_parameters"},
  "field": {"node": "field_declaration", "name": "name", "type": "type"},
  "enum": {"node": "enum_item", "name": "name", "variant": "enum_variant", "variant_name": "name"},
  "impl": {"node": "impl_item", "type": "type", "trait": "trait", "own_type": "Self"},
  "function": {"node": "function_item", "name": "name", "parameters": "parameters", "body": "body",
               "generics": "type_parameters", "modifiers": "function_modifiers",
               "left_out": ["async", "unsafe", "extern", "const"]},
  "receiver": {"node": "self_parameter", "shared": "&", "name": "self"},
  "parameter": {"node": "parameter", "name": "pattern", "type": "type"},
  "module": {"node": "mod_item", "body": "body"},
  "attribute": "attribute_item",
  "comments": ["line_comment", "block_comment"],
  "test_marker": "cfg(test)",
  "conditional_marker": "cfg(",
  "shared": "Arc",
  "observe": {
    "bool": "{x}",
    "AtomicBool": "{x}.load(std::sync::atomic::Ordering::SeqCst)",
    "Option": "{x}.is_some()",
    "OnceLock": "{x}.get().is_some()",
    "OnceCell": "{x}.get().is_some()"
  },
  "enter": {"Arc": "(*{x})", "Rc": "(*{x})", "Box": "(*{x})"},
  "enter_if_free": {"Mutex": "{x}.try_lock()", "RwLock": "{x}.try_read()", "RefCell": "{x}.try_borrow()"},
  "inside": "(**h)",
  "if_free": "match &{try} { Ok(h) => {read}, Err(_) => 255u8 }",
  "variant": "{E}::{V} { .. } => {n}u8,",
  "pick": "match &{x} { {arms} #[allow(unreachable_patterns)] _ => 254u8 }",
  "parent": "super::",
  "statement": "#[cfg(test)] let {local} = {part}::watch_{T}(&*{value}, {at:?});",
  "statement_for_receiver": "#[cfg(test)] let {local} = {part}::watch_{T}(self, {at:?});"
}
