+def _fields(value: object, *names: str) -> dict[str, str]:
+    """Select named canonical fields in declaration order, retaining full validation."""
+    return {name: _field(value, name) for name in names}
+
+
 def _field(value: object, field_name: str) -> str:
     return _text(as_canonical_mapping(value)[field_name])
 
