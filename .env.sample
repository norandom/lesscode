# Model endpoint for lesscode research tooling (Slice B and the regenerator).
# Copy to .env, fill in the key, and point the tools at it:
#   $env:LESSCODE_MODEL_ENV = "$PWD\.env"      (PowerShell)
# Without LESSCODE_MODEL_ENV the tools read %USERPROFILE%\.lesscode\model.env.
# .env is git-ignored. Never commit a real key.

# Mistral (OpenAI-compatible chat completions)
LESSCODE_MODEL_API_STYLE=openai
LESSCODE_MODEL_BASE_URL=https://api.mistral.ai/v1
LESSCODE_MODEL_NAME=mistral-large-4
LESSCODE_MODEL_API_KEY=replace-with-your-key

# Anthropic (Messages API) instead:
# LESSCODE_MODEL_API_STYLE=anthropic
# LESSCODE_MODEL_BASE_URL=https://api.anthropic.com
# LESSCODE_MODEL_NAME=claude-opus-5-5
# LESSCODE_MODEL_API_KEY=replace-with-your-key